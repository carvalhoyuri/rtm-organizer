# Banco (Postgres do Supabase — Project Settings > Database > Connection string).
# DATABASE_URL: connection pooling (porta 6543, pgbouncer=true) — usada em runtime.
# DIRECT_URL: conexão direta (porta 5432) — só usada por `prisma db push`/`migrate`,
# que não funcionam através do pooler.
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres"

# Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# service_role key (Project Settings > API) — bypassa RLS, só usada por
# test/integration/ (cria/apaga usuários de teste via Admin API pra checar o
# trigger handle_new_user). NUNCA expor no client, nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# E-mail(s) do admin global (separados por vírgula) — único papel que cria Edições
# e sobe PDFs da programação (ver docs/adr/0004). Não é salvo no banco.
ADMIN_EMAIL=""
